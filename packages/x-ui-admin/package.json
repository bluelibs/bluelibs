{
  "name": "@bluelibs/x-ui-admin",
  "version": "1.6.5",
  "public": true,
  "description": "The administration interface built for speed.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluelibs/bluelibs"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run compile",
    "test": "jest --verbose --passWithNoTests",
    "test:dev": "jest --verbose --watch src/__tests__/index.ts --detectOpenHandles",
    "test:clean": "jest --clearCache",
    "testonly": "npm test",
    "test:ci": "npm run coverage -- --ci --maxWorkers=2  --reporters=default --reporters=jest-junit",
    "coverage": "npm test -- --coverage",
    "coverage:upload": "codecov",
    "prepublishOnly": "npm run compile",
    "gen-doc": "typedoc ./src/index.ts --exclude ./src/__tests__ --out typeDocs --tsconfig tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "lodash.debounce": "^4.0.8",
    "lodash.startcase": "^4.4.0"
  },
  "peerDependencies": {
    "@ant-design/icons": "^4.6.4",
    "@bluelibs/core": "^1.0.0",
    "@bluelibs/ejson": "^1.0.0",
    "@bluelibs/x-ui": "^1.0.0",
    "@bluelibs/x-ui-i18n-bundle": "^1.2.0",
    "@bluelibs/x-ui-react-router-bundle": "^1.0.4",
    "antd": "^4.12.3 || ^5.0.0",
    "moment": "^2.25.3",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.1 || ^18.0.0"
  },
  "devDependencies": {
    "@apollo/client": "^3.2.1",
    "@bluelibs/core": "^1.0.0",
    "@bluelibs/ejson": "^1.0.0",
    "@bluelibs/smart": "^1.0.0",
    "@bluelibs/x-ui": "^1.2.2",
    "@bluelibs/x-ui-react-router-bundle": "^1.0.4",
    "@bluelibs/x-ui-router": "^1.0.0",
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/graphql": "^0.11.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/node-polyglot": "^2.4.2",
    "@types/react": "^17.0.35",
    "@types/react-router-dom": "^5.1.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "antd": "^4.12.3",
    "chai": "^4.4.1",
    "chai-as-promised": "^7.1.1",
    "cross-fetch": "^3.0.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "graphql": "^15.5.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "moment": "^2.25.3",
    "prettier": "^3.2.5",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.1 || ^18.0.0",
    "react-router-dom": "^5.2.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
