{
  "name": "@bluelibs/nova",
  "version": "1.8.1",
  "description": "Nova is a relational query layer over MongoDB Node Drivers",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluelibs/bluelibs"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run compile",
    "test": "jest --verbose --passWithNoTests",
    "test:clean": "jest --clearCache",
    "test:dev": "jest --verbose --watch src/__tests__/index.ts --detectOpenHandles",
    "test:watch": "jest --verbose --watch",
    "testonly": "npm test",
    "test:ci": "npm run coverage -- --ci --maxWorkers=2  --reporters=default --reporters=jest-junit",
    "coverage": "npm test -- --coverage",
    "coverage:upload": "codecov",
    "prepublishOnly": "npm run compile",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "dot-object": "^2.1.4",
    "graphql-fields": "^2.0.3",
    "lodash": "^4.17.15"
  },
  "peerDependencies": {
    "mongodb": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/graphql": "^0.11.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "chai": "^4.4.1",
    "chai-as-promised": "^7.1.1",
    "graphql": "^15.0.0",
    "graphql-tag": "^2.10.3",
    "jest": "^29.7.0",
    "mongodb": "^6.8.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest-junit": "^16.0.0"
  },
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
