{
  "name": "@bluelibs/rabbitmq-bundle",
  "version": "1.1.0",
  "description": "BlueLibs rabbitmq-bundle",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluelibs/bluelibs"
  },
  "scripts": {
    "compile": "tsc",
    "build": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run build",
    "test": "jest --verbose --passWithNoTests",
    "test:dev": "jest --verbose src/__tests__/index.ts --watch",
    "test:clean": "jest --clearCache",
    "testonly": "npm test",
    "test:ci": "npm run coverage -- --ci --maxWorkers=2  --reporters=default --reporters=jest-junit",
    "coverage": "npm test -- --coverage",
    "coverage:upload": "codecov",
    "prepublishOnly": "npm run build",
    "gen-doc": "typedoc ./src/index.ts --exclude ./src/__tests__ --out typeDocs --tsconfig tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "amqplib": "^0.8.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.8.1",
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chai": "^4.4.1",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "@bluelibs/core": "^1.0.0",
    "@bluelibs/ejson": "^1.0.0",
    "@bluelibs/logger-bundle": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
