{
  "name": "@bluelibs/x-auth-bundle",
  "version": "1.2.3",
  "description": "Password integration with Apollo Bundle using X-Framework.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluelibs/bluelibs"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run compile",
    "test": "jest --verbose --passWithNoTests",
    "test:dev": "jest --verbose --watch src/__tests__/index.ts --detectOpenHandles",
    "test:clean": "jest --clearCache",
    "test:watch": "jest --verbose --watch",
    "testonly": "npm test",
    "test:ci": "npm run coverage -- --ci --maxWorkers=2  --reporters=default --reporters=jest-junit",
    "coverage": "npm test -- --coverage",
    "coverage:upload": "codecov",
    "prepublishOnly": "npm run compile",
    "gen-doc": "typedoc ./src/index.ts --exclude ./src/__tests__ --out typeDocs --tsconfig tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "peerDependencies": {
    "@bluelibs/core": "^1.0.0",
    "@bluelibs/email-bundle": "^1.0.0",
    "@bluelibs/graphql-bundle": "^2.0.0",
    "@bluelibs/http-bundle": "^1.0.2",
    "@bluelibs/mongo-bundle": "^1.0.0",
    "@bluelibs/password-bundle": "^1.0.0",
    "@bluelibs/security-bundle": "^1.0.0",
    "@bluelibs/security-mongo-bundle": "^1.0.0",
    "@bluelibs/validator-bundle": "^1.0.0",
    "@bluelibs/x-bundle": "^1.5.0"
  },
  "devDependencies": {
    "@bluelibs/core": "^1.0.0",
    "@bluelibs/email-bundle": "^1.0.0",
    "@bluelibs/graphql-bundle": "^2.0.0",
    "@bluelibs/http-bundle": "^1.0.2",
    "@bluelibs/mongo-bundle": "^1.0.0",
    "@bluelibs/nova": "^1.0.0",
    "@bluelibs/password-bundle": "^1.0.0",
    "@bluelibs/security-bundle": "^1.1.8",
    "@bluelibs/security-mongo-bundle": "^1.2.4",
    "@bluelibs/validator-bundle": "^1.0.0",
    "@bluelibs/x-bundle": "^1.5.0",
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/passport-strategy": "^0.2.35",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chai": "^4.4.1",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "license": "MIT",
  "dependencies": {
    "graphql-subscriptions": "^2.0.0",
    "passport": "^0.6.0",
    "superagent": "^7.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
