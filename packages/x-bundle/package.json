{
  "name": "@bluelibs/x-bundle",
  "version": "1.8.0",
  "description": "X-Framework is a feature-rich solution with fast prototyping in mind for BlueLibs",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluelibs/bluelibs"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run compile",
    "test": "jest --verbose src/__tests__/index.ts --passWithNoTests",
    "test:dev": "NODE_ENV=production jest --verbose --watch src/__tests__/index.ts --detectOpenHandles",
    "test:clean": "jest --clearCache",
    "test:watch": "jest --verbose --watch dist/__tests__/index.js",
    "testonly": "npm test",
    "test:ci": "npm run coverage -- --ci --maxWorkers=2  --reporters=default --reporters=jest-junit",
    "coverage": "npm test -- --coverage",
    "coverage:upload": "codecov",
    "prepublishOnly": "npm run compile",
    "package:generate": "ts-node package.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "cache-manager": "^3.6.0",
    "chalk": "^4.1.0",
    "date-fns": "^2.14.0",
    "dot-object": "^2.1.4",
    "graphql-fields": "^2.0.3",
    "graphql-type-json": "^0.3.2",
    "lodash.get": "^4.4.2",
    "lodash.merge": "^4.6.2",
    "node-object-hash": "^2.3.10",
    "queue": "^6.0.2",
    "redis": "^3.0.2",
    "uuid": "^11.1.1",
    "ws": "^8.13.0"
  },
  "peerDependencies": {
    "@bluelibs/core": "^1.0.0",
    "@bluelibs/ejson": "^1.2.1",
    "@bluelibs/graphql-bundle": "^2.0.0",
    "@bluelibs/logger-bundle": "^1.0.0",
    "@bluelibs/mongo-bundle": "^1.8.0",
    "@bluelibs/nova": "^1.3.0",
    "@bluelibs/security-bundle": "^1.0.0",
    "@bluelibs/validator-bundle": "^1.0.0",
    "graphql": "^16.0.0 || ^15.3.0 || ^14.0.0"
  },
  "devDependencies": {
    "@apollo/client": "^3.7.11",
    "@bluelibs/apollo-bundle": "^2.2.0",
    "@bluelibs/apollo-security-bundle": "^2.1.0",
    "@bluelibs/core": "^1.3.0",
    "@bluelibs/ejson": "^1.6.0",
    "@bluelibs/email-bundle": "^1.1.0",
    "@bluelibs/graphql-bundle": "^2.1.0",
    "@bluelibs/logger-bundle": "^1.6.0",
    "@bluelibs/mongo-bundle": "^1.9.0",
    "@bluelibs/nova": "^1.10.0",
    "@bluelibs/password-bundle": "^1.2.0",
    "@bluelibs/security-bundle": "^1.2.0",
    "@bluelibs/security-mongo-bundle": "^1.3.0",
    "@bluelibs/validator-bundle": "^1.2.0",
    "@types/cache-manager": "^3.4.3",
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/dot-object": "^2.1.2",
    "@types/express": "^4.17.13",
    "@types/graphql-fields": "^1.3.4",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/serve-static": "^1.13.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chai": "^4.4.1",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "express-serve-static-core": "^0.1.1",
    "graphql": "^16.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "mongodb": "^6.0.0",
    "node-fetch": "^2.6.1",
    "prettier": "^3.2.5",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.1 || ^18.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "yup": "^1.0.0"
  },
  "types": "dist/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
