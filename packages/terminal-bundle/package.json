{
  "name": "@bluelibs/terminal-bundle",
  "version": "1.0.0",
  "description": "Offers the toolkit to build highly scalable and decoupled terminal interogations and file system writes.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluelibs/bluelibs"
  },
  "scripts": {
    "command": "dist/cli.js",
    "compile": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run compile",
    "test": "jest --verbose --passWithNoTests",
    "test:clean": "jest --clearCache",
    "test:watch": "jest --verbose --watch",
    "testonly": "npm test",
    "test:ci": "npm run coverage -- --ci --maxWorkers=2  --reporters=default --reporters=jest-junit",
    "coverage": "npm test -- --coverage",
    "coverage:upload": "codecov",
    "prepublishOnly": "npm run compile",
    "gen-doc": "typedoc ./src/index.ts --exclude ./src/__tests__ --out typeDocs --tsconfig tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "chalk": "^4.0.0",
    "commander": "^5.1.0",
    "fuzzy": "^0.1.3",
    "glob": "^7.1.6",
    "inquirer": "^7.1.0",
    "inquirer-autocomplete-prompt": "^1.0.2",
    "inquirer-search-list": "^1.2.6",
    "merge-deep": "^3.0.2",
    "mkdirp": "^1.0.4",
    "recursive-copy": "^2.0.10"
  },
  "devDependencies": {
    "@bluelibs/core": "^1.0.0",
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/graphql": "^0.11.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chai": "^4.4.1",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "typescript": "^5.3.3",
    "ts-jest": "^29.1.1"
  },
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
