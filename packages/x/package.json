{
  "name": "@bluelibs/x",
  "version": "1.15.20",
  "description": "Scaffolding tool for BlueLibs Framework using X-Framework.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelibs/x-generator-bundle.git"
  },
  "bin": {
    "x": "dist/cli.js"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run compile",
    "test": "jest --verbose --passWithNoTests",
    "test:clean": "jest --clearCache",
    "test:watch": "jest --verbose --watch",
    "testonly": "npm test",
    "test:ci": "npm run coverage -- --ci --maxWorkers=2  --reporters=default --reporters=jest-junit",
    "coverage": "npm test -- --coverage",
    "coverage:upload": "codecov",
    "prepublishOnly": "npm run compile",
    "gen-doc": "typedoc ./src/index.ts --exclude ./src/__tests__ --out typeDocs --tsconfig tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@bluelibs/core": "^1.0.0",
    "@bluelibs/ejson": "^1.2.1",
    "@bluelibs/terminal-bundle": "^1.0.0",
    "@graphql-tools/merge": "^9.0.0",
    "@graphql-tools/utils": "^10.0.6",
    "@types/faker": "^5.5.7",
    "chalk": "^2.4.2",
    "faker": "^5.5.3",
    "fast-glob": "^3.2.2",
    "fs-extra": "^9.0.0",
    "graphql": "^16.6.0",
    "handlebars": "^4.7.6",
    "inflected": "^2.1.0",
    "lodash": "^4.17.15",
    "lodash.merge": "^4.6.2"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/fs-extra": "^9.0.1",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.154",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chai": "^4.4.1",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "run-script-os": "^1.1.6",
    "source-map-support": "^0.5.21",
    "typescript": "^5.3.3",
    "ts-jest": "^29.1.1",
    "prettier": "^3.2.5"
  },
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bluelibs/bluelibs"
  },
  "homepage": "https://github.com/bluelibs/bluelibs",
  "author": "Theodor Diaconu",
  "engines": {
    "node": ">=18.0.0"
  }
}
