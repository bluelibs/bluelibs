{
  "name": "@bluelibs/apollo-bundle",
  "version": "2.1.2",
  "description": "Zero-config Apollo/GraphQL solution for BlueLibs Framework",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluelibs/bluelibs"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run compile",
    "test": "jest --verbose --passWithNoTests",
    "test:clean": "jest --clearCache",
    "test:dev": "jest --verbose --watch src/__tests__/index.ts --detectOpenHandles",
    "test:watch": "jest --verbose --watch",
    "testonly": "npm test",
    "test:ci": "npm run coverage -- --ci --maxWorkers=2  --reporters=default --reporters=jest-junit",
    "coverage": "npm test -- --coverage",
    "coverage:upload": "codecov",
    "prepublishOnly": "npm run compile",
    "gen-doc": "typedoc ./src/index.ts --exclude ./src/__tests__ --nulout typeDocs --tsconfig tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@as-integrations/aws-lambda": "^2.0.1",
    "@graphql-tools/schema": "^8.3.0",
    "cookie-parser": "^1.4.5",
    "express": "^4.17.1",
    "graphql-jit": "^0.8.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-upload": "^16.0.2",
    "graphql-ws": "^5.12.1",
    "tiny-lru": "^7.0.6"
  },
  "peerDependencies": {
    "@apollo/server": "^4.9.5",
    "@bluelibs/core": "^1.0.2",
    "@bluelibs/graphql-bundle": "^2.0.0",
    "graphql": "^16.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@apollo/client": "^3.7.11",
    "@apollo/server": "^4.11.3",
    "@babel/core": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@bluelibs/core": "^1.0.2",
    "@bluelibs/email-bundle": "^1.0.1",
    "@bluelibs/graphql-bundle": "^2.0.0",
    "@bluelibs/logger-bundle": "^1.5.1",
    "@bluelibs/security-bundle": "^1.0.4",
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.13",
    "@types/graphql": "^14.2.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/ws": "^8.5.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-jest": "^29.5.0",
    "chai": "^4.4.1",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "graphql": "^16.0.0",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "mocha": "^9.1.3",
    "plugin": "^0.0.15",
    "prettier": "^3.2.5",
    "serverless": "^4.33.0",
    "serverless-offline": "^14.5.0",
    "serverless-plugin-typescript": "^2.1.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "ws": "*"
  },
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
